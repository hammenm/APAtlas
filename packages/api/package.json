{
  "name": "@atlas/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/index.ts",
    "./domain": "./src/domain/index.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "db:generate": "bun --bun --env-file=../../.env drizzle-kit generate",
